[project]
title = Slasher-prototype
version = 1.4
publisher = 
developer = Dragosha
write_log = 0
write_log_file = 0
minimum_log_level = 1
compress_archive = 1
title_as_file_name = Slasherprototype

[display]
width = 1600
height = 900
high_dpi = 0
samples = 0
fullscreen = 0
display_profiles = /builtins/render/default.display_profilesc
dynamic_orientation = 0
update_frequency = 0
swap_interval = 1
vsync = 1
variable_dt = 0
display_device_info = 0

[render]
clear_color_red = 0
clear_color_green = 0
clear_color_blue = 0
clear_color_alpha = 1

[physics]
max_collision_object_count = 128
type = 2D
use_fixed_timestep = 1
debug = 0
debug_alpha = 0.9
debug_scale = 30
world_count = 4
gravity_x = 0
gravity_y = 0.0
gravity_z = 0
scale = 1
allow_dynamic_transforms = 1
max_collisions = 64
max_contacts = 128
contact_impulse_limit = 0
ray_cast_limit_2d = 64
ray_cast_limit_3d = 128
trigger_overlap_capacity = 16
velocity_threshold = 1
max_fixed_timesteps = 2

[box2d]
velocity_iterations = 10
position_iterations = 10
sub_step_count = 4

[bootstrap]
main_collection = /main/scene.collectionc
render = /render/render.renderc
debug_init_script = 

[graphics]
default_texture_min_filter = linear
default_texture_mag_filter = linear
max_draw_calls = 1024
max_characters = 8192
max_font_batches = 128
max_debug_vertices = 10000
texture_profiles = /builtins/graphics/default.texture_profiles
verify_graphics_calls = 1
opengl_version_hint = 33
opengl_core_profile_hint = 1
vulkan_version_major = 1
vulkan_version_minor = 0
memory_size = 512

[shader]
