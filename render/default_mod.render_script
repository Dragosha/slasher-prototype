local IDENTITY_MATRIX = vmath.matrix4()
local rt_list = {}
local BLACK = vmath.vector4(0)
local AMBIENT_LIGHT = vmath.vector4(0.3, 0.4, 0.4, 1.0)


local function render_target(name, w, h, no_depth)
    local already_rt = rt_list[name]
    if already_rt and already_rt.w == w and already_rt.h == h then
        -- nothing changed
        return already_rt
    elseif already_rt then
        -- rt is already created, but size is changing. Fix it.
        already_rt.w = w
        already_rt.h = h
        render.set_render_target_size(already_rt.rt, w, h)
        -- pprint(already_rt)
        return already_rt
    end

    --otherwise create a new RT 

    local color_params = {
        format     = graphics.TEXTURE_FORMAT_RGBA,
        width      = w,
        height     = h,
        min_filter = graphics.TEXTURE_FILTER_LINEAR,
        mag_filter = graphics.TEXTURE_FILTER_LINEAR,
        u_wrap     = graphics.TEXTURE_WRAP_CLAMP_TO_EDGE,
        v_wrap     = graphics.TEXTURE_WRAP_CLAMP_TO_EDGE }

    local rt
    if not no_depth then
        local depth_params = {
            flags         = render.TEXTURE_BIT, -- this will create the depth buffer as a texture
            format        = graphics.TEXTURE_FORMAT_DEPTH,
            width         = w,
            height        = h,
            u_wrap        = graphics.TEXTURE_WRAP_CLAMP_TO_EDGE,
            v_wrap        = graphics.TEXTURE_WRAP_CLAMP_TO_EDGE }

        rt = render.render_target(name, {[graphics.BUFFER_TYPE_COLOR0_BIT] = color_params, [graphics.BUFFER_TYPE_DEPTH_BIT] = depth_params })
    else
        rt = render.render_target(name, {[graphics.BUFFER_TYPE_COLOR0_BIT] = color_params })
    end
    local new_rt = {rt = rt, w = w, h = h}
    rt_list[name] = new_rt
    return new_rt
end

local function render_clear(color, depth, stencil)
    if depth then
        render.set_depth_mask(true)
    end

    if stencil then
        render.set_stencil_mask(0xff)
    end
    render.clear({
        [graphics.BUFFER_TYPE_COLOR0_BIT] = color,
        [graphics.BUFFER_TYPE_DEPTH_BIT] = 1,
        [graphics.BUFFER_TYPE_STENCIL_BIT] = 0
    })
end
-------------------------------------------------

function init(self)
    self.predicates = create_predicates("tile", "gui", "particle", "model", "debug_text",
    -- additional predicates:
        "bgtile", "overtile", "quad", "light")

    -- default is stretch projection. copy from builtins and change for different projection
    -- or send a message to the render script to change projection:
    -- msg.post("@render:", "use_stretch_projection", { near = -1, far = 1 })
    -- msg.post("@render:", "use_fixed_projection", { near = -1, far = 1, zoom = 2 })
    -- msg.post("@render:", "use_fixed_fit_projection", { near = -1, far = 1 })

    local state = create_state()
    self.state = state

    local camera_world = create_camera(state, "camera_world", true)
    init_camera(camera_world, get_stretch_projection)
    local camera_gui = create_camera(state, "camera_gui")
    init_camera(camera_gui, get_gui_projection)
    -- Create a special camera that wraps camera components (if they exist)
    -- It will take precedence over any other camera, and not change from messages
    local camera_component = create_camera(state, "camera_component")
    update_state(state)



-------------------------------------------------
    self.constants = render.constant_buffer()
    -- creates 2 separate render targets for lights and for all other objects
    local window_width = render.get_window_width()
    local window_height = render.get_window_height()
    self.normal_rt = render_target("normal_rt", window_width, window_height)
    self.light_rt = render_target("light_rt", window_width, window_height, true)
-------------------------------------------------

end

function update(self)

-------------------------------------------------
--  Fix render targets size if screen size has changed
    local window_width = render.get_window_width()
    local window_height = render.get_window_height()
    render_target("normal_rt", window_width, window_height)
    render_target("light_rt", window_width, window_height)
-------------------------------------------------

    local state = self.state
    if not state.valid then
        if not update_state(state) then
            return
        end
    end

    local predicates = self.predicates
    -- clear screen buffers
    --
    -- turn on depth_mask before `render.clear()` to clear it as well
    render.set_depth_mask(true)
    render.set_stencil_mask(0xff)
    render.clear(state.clear_buffers)

    -- setup camera view and projection
    --
    local draw_options_world = set_camera_world(state)

-------------------------------------------------
draw_options_world.constants = self.constants -- add our constants to the default camera options
draw_options_world.frustum_planes = render.FRUSTUM_PLANES_ALL
-------------------------------------------------

    render.set_viewport(0, 0, state.window_width, state.window_height)

-------------------------------------------------
--  First step:
--  render world to render target
    render.set_render_target(self.normal_rt.rt)
    render_clear(BLACK)
-------------------------------------------------

    -- set states used for all the world predicates
    render.set_blend_func(graphics.BLEND_FACTOR_SRC_ALPHA, graphics.BLEND_FACTOR_ONE_MINUS_SRC_ALPHA)
    render.enable_state(graphics.STATE_DEPTH_TEST)

    -- render `model` predicate for default 3D material
    --
    render.enable_state(graphics.STATE_CULL_FACE)
    render.draw(predicates.model, draw_options_world)
    render.set_depth_mask(false)
    render.disable_state(graphics.STATE_CULL_FACE)

    -- render the other components: sprites, tilemaps, particles etc
    --
    render.enable_state(graphics.STATE_BLEND)
    render.draw(predicates.bgtile, draw_options_world)
    render.draw(predicates.tile, draw_options_world)
    render.draw(predicates.particle, draw_options_world)
    render.draw(predicates.overtile, draw_options_world)
    render.disable_state(graphics.STATE_DEPTH_TEST)

    render.draw_debug3d()


-------------------------------------------------
--  Second step:
--  render lights to another render target
    render.set_render_target(self.light_rt.rt)
    render_clear(self.ambient or AMBIENT_LIGHT)

    self.light_power = self.light_power or 1.5
    self.light_gain = self.light_gain or 0.01
    self.light_power = self.light_power + self.light_gain
    if self.light_power > 2 then 
        self.light_gain = -0.01
    elseif self.light_power < 1.3 then
        self.light_gain = 0.01
    end
    self.constants.time = vmath.vector4(self.light_power, 1, 1, 1)

    render.draw(predicates.light, draw_options_world)
--------------------------------------------------


    -- Reset default camera
    reset_camera_world(state)

--------------------------------------------------
--  Final step
--  render MIX of ours render targets to DEFAULT target (screen buffer)
    render.set_render_target(render.RENDER_TARGET_DEFAULT)
    -- Default RT is already cleared above

    render.set_view(IDENTITY_MATRIX)
    render.set_projection(IDENTITY_MATRIX)

    render.enable_texture(0, self.normal_rt.rt, graphics.BUFFER_TYPE_COLOR0_BIT)
    render.enable_texture(1, self.light_rt.rt, graphics.BUFFER_TYPE_COLOR0_BIT)
    render.draw(predicates.quad, draw_options_world)
    render.disable_texture(0)
    render.disable_texture(1)
--------------------------------------------------



    -- render GUI
    --
    local camera_gui = state.cameras.camera_gui
    render.set_view(camera_gui.view)
    render.set_projection(camera_gui.proj)

    render.enable_state(graphics.STATE_STENCIL_TEST)
    render.draw(predicates.gui, camera_gui.options)
    render.draw(predicates.debug_text, camera_gui.options)
    render.disable_state(graphics.STATE_STENCIL_TEST)
    render.disable_state(graphics.STATE_BLEND)
end

